# Copy this file to .env and set the URL of your Laravel backend.
# Emulator (Android Studio): http://10.0.2.2:8000
# Real phone: your PC's LAN IP, e.g. http://192.168.1.100:8000
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# Google OAuth Web Client ID (from Google Cloud Console)
# Must match GOOGLE_CLIENT_ID in backend/.env
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
