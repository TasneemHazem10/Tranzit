{
  "expo": {
    "name": "Tranzit",
    "slug": "tranzit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tranzit",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tranzit.shipping",
      "config": {
        "googleMapsApiKey": "AIzaSyDrzPTEiAG3SzfIOsmfs0YAyFjJLiByqr8"
      }
    },
    "android": {
      "package": "com.tranzit.shipping",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1E1E1C"
      },
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDFJVPI73Mn5PiX03CZL8F1475yC0dVeBg"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E1E1C",
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "يحتاج ترانزيت الوصول لموقعك لتحديد نقاط الشحن والتتبع."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "يحتاج ترانزيت الوصول لصورك لإرفاق إثبات التسليم.",
          "cameraPermission": "يحتاج ترانزيت استخدام الكاميرا لتصوير إثبات التسليم."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
